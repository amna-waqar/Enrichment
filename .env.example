# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Read-only API key from Chargebee (Settings > Configure Chargebee > API Keys).
# Live keys start with "live_", test keys with "test_".
CHARGEBEE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxx

# Your site subdomain: the part before ".chargebee.com" in your admin URL.
# e.g. if you log in at https://acme.chargebee.com then the site is "acme".
# This is REQUIRED and cannot be derived from the API key.
CHARGEBEE_SITE=acme

# OPTIONAL — only if your account is on a non-US regional cluster.
# Leave unset for the default US cluster. Examples: eu, au, in.
# CHARGEBEE_REGION=eu

# OPTIONAL — full custom domain override (takes precedence over region).
# CHARGEBEE_DOMAIN=acme.eu.chargebee.com
